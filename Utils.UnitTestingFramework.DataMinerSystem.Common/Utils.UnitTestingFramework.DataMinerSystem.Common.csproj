<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Skyline.DataMiner.Utils.UnitTestingFramework.DataMinerSystem.Common</AssemblyName>
    <RootNamespace>Skyline.DataMiner.Utils.UnitTestingFramework.DataMinerSystem.Common</RootNamespace>
    <PackageVersion>1.0.0</PackageVersion>
    <Version>1.0.0</Version>
    <PackageTags>Skyline;DataMiner</PackageTags>
    <PackageProjectUrl>https://skyline.be</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageIcon>Icon.png</PackageIcon>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Authors>SkylineCommunications</Authors>
    <Company>Skyline Communications</Company>
    <Description>The Unit Testing Framework was developed to simplify how Unit Tests are made when developing Connectors. This package provides a pre-arranged mock of IDmsElement (Skyline.DataMiner.Core.DataMinerSystem.Common) so developers can unit test code that interacts with elements through the DataMiner System interfaces.</Description>
    <OutputType>Library</OutputType>
    <RepositoryUrl>https://github.com/SkylineCommunications/Skyline.DataMiner.Utils.UnitTestingFramework</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageId>Skyline.DataMiner.Utils.UnitTestingFramework.DataMinerSystem.Common</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="..\Utils.UnitTestingFramework.Protocol\LICENSE.txt" Pack="true" PackagePath="" />
    <None Include="..\Utils.UnitTestingFramework.Protocol\nuget\Icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="Skyline.DataMiner.Core.DataMinerSystem.Common" Version="1.2.0.3" />
    <PackageReference Include="Skyline.DataMiner.Utils.SecureCoding.Analyzers" Version="2.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Utils.UnitTestingFramework.Common\Utils.UnitTestingFramework.Common.csproj" />
  </ItemGroup>
</Project>
